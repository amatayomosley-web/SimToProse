# secrets / env
.env
.env.*
*.key
secrets/

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# os / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# large media / model artifacts
*.safetensors
*.gguf
*.ckpt
*.mp4
*.wav
*.png
*.jpg

# runtime ledger state — run artifacts, never source (run-lifecycle.md)
runs/*.db
runs/*.db-wal
runs/*.db-shm
runs/*.db.directions/
# ...and under ANY runs/ at any depth: a personal clone keeps its books under books/, each with its own
# runs/ (drafts and history copies included) - chronicle databases are save-files, never commits (gate clone-role)
**/runs/**/*.db
**/runs/**/*.db-wal
**/runs/**/*.db-shm
**/runs/**/*.db.directions/
# a book's lease (gate draft-flow): an operating-system lock file, machine-local; the lineage log beside it is kept
**/runs/.lease
# the public test book under examples/ (owner, 2026-09-27): its notes are tracked; what running it makes - the chronicle,
# drafts, history, lineage, seat prompts, rendered prose - is machine-local and never committed
examples/*/runs/
examples/*/prose/

# a book folder opened in Obsidian inside a clone
.obsidian/

# the files that live BESIDE the books (<parent of $SWE_BOOKS>): if a clone keeps its books in books/, that parent
# is the clone's root - these must never be committed there, and a list inside the checkout does not count anyway
/private-remotes.txt
/private-terms.txt
/name-review.txt
/publish-reviews/

# Claude Code's per-user, machine-local files
.claude/settings.local.json
CLAUDE.local.md

# scratch
staging/
tmp/

# memsearch plugin tool-state (machine-local)
.memsearch/

# depth-gate working state — local workflow, not product
.depth/

# router telemetry - machine-local tuning data, not source
.claude/.router_fires.jsonl
